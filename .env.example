# ---------------------------------------------------------------------------
# Copiar a .env y ajustar. NUNCA commitear el .env real.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Zona horaria del negocio. Base de datos, API y web deben usar la misma: si
# difieren, una fecha local se guarda desplazada un día entre procesos.
TZ=America/Bogota

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Base de datos ---------------------------------------------------------
# Dentro de Docker el host es `db`; desde el equipo, `localhost`.
# El puerto publicado en el host puede diferir del interno: ajústalo si el
# 5432 ya está ocupado por otro PostgreSQL.
POSTGRES_USER=kairo
POSTGRES_PASSWORD=kairo_dev_password
POSTGRES_DB=kairo
POSTGRES_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=8080

# Usada por el backend dentro de Docker.
DATABASE_URL="postgresql://kairo:kairo_dev_password@db:5432/kairo?schema=public"
# Usada por Prisma Studio y por las pruebas desde el host.
DATABASE_URL_LOCAL="postgresql://kairo:kairo_dev_password@localhost:5433/kairo?schema=public"

# --- Autenticación ---------------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiame-en-produccion-access-secret-min-32-caracteres
JWT_REFRESH_SECRET=cambiame-en-produccion-refresh-secret-min-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# Firmado del token CSRF.
CSRF_SECRET=cambiame-en-produccion-csrf-secret-min-32-caracteres

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Relaja el límite de autenticación. Solo para la suite e2e, que hace muchas
# peticiones desde la misma IP. En producción déjalo en false.
RELAJAR_RATE_LIMIT=false

# --- Frontend --------------------------------------------------------------
# Vacío = mismo origen (nginx hace proxy de /api al backend). Solo hace falta
# si el API se sirve en otro host.
VITE_API_URL=